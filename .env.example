# Copia este archivo a  .env  y rellena los valores. NUNCA subas .env al repo.
#   cp .env.example .env

# --- Sesión ---------------------------------------------------------------
# Clave para firmar las cookies de sesión. OBLIGATORIA en producción (>=32 chars).
# Déjala vacía en desarrollo local y se generará una efímera automáticamente.
# Genera una para producción así:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
COACH_SECRET_KEY=

# --- Base de datos --------------------------------------------------------
# En desarrollo local se usa SQLite por defecto (no toques esto).
# En producción, pon la URL de PostgreSQL, p. ej.:
#   DATABASE_URL=postgresql+psycopg://usuario:clave@host:5432/coach
DATABASE_URL=sqlite:///gastos.db

# --- API de Claude (Anthropic) --------------------------------------------
# Tu clave secreta de https://console.anthropic.com  (empieza con sk-ant-api03-...)
# ⚠️ Esto es un secreto: no lo compartas ni lo subas al repo.
ANTHROPIC_API_KEY=sk-ant-api03-pon-aqui-tu-clave

# Modelos: Haiku para extraer (barato) y Opus para el comentario del coach.
CLAUDE_MODEL_EXTRACTOR=claude-haiku-4-5
CLAUDE_MODEL_COACH=claude-opus-4-8

# --- Búsqueda semántica de gastos (RAG; opcional) --------------------------
# Embeddings de Voyage AI (200M tokens gratis): https://voyageai.com
# Sin esta clave el coach simplemente no ofrece la búsqueda por significado.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite

# --- LangSmith (observabilidad LLM; opcional pero recomendado) -------------
# Trazas de cada conversación del coach LangGraph: árbol agente → modelo →
# tools, con tokens, costo y latencia por paso. No requiere código: LangChain
# lo activa solo con estas variables.
# 1. Cuenta gratis en https://smith.langchain.com
# 2. Settings → API Keys → crea una clave (empieza con lsv2_...)
# 3. Pon LANGSMITH_TRACING=true y tu clave aquí.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_pon-aqui-tu-clave
LANGSMITH_PROJECT=coach-gastos

# --- Motor del coach --------------------------------------------------------
# "langgraph" usa coach_agent_lg.py (LangGraph + checkpointer); sin definir,
# usa el bucle original de coach_agent.py.
# COACH_ENGINE=langgraph
# Archivo donde LangGraph persiste la memoria de conversación por usuario:
# COACH_CHECKPOINT_DB=checkpoints.db

# --- Login con Google (OAuth) ---------------------------------------------
# Crea credenciales OAuth en https://console.cloud.google.com/apis/credentials
# Tipo "ID de cliente de OAuth" → "Aplicación web".
# Redirect URI autorizado (debe coincidir EXACTO):
#   local:       http://localhost:8000/auth/callback
#   producción:  https://TU-DOMINIO/auth/callback
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx

# --- Servidor -------------------------------------------------------------
COACH_HOST=127.0.0.1
COACH_PORT=8000
# En producción (detrás de HTTPS) pon esto en 1 para exigir cookies seguras.
COACH_HTTPS=0

# --- Entorno y modo demo --------------------------------------------------
# COACH_ENV: "development" o "production". Si no lo pones, se infiere
# (Postgres o COACH_HTTPS=1 => production). En producción la app se NIEGA a
# arrancar sin COACH_SECRET_KEY y sin login de Google configurado.
# COACH_ENV=development
#
# Modo demo (login local sin Google). Por defecto: activado en desarrollo,
# desactivado en producción. Para forzarlo: COACH_ALLOW_DEMO=1 (no recomendado en prod).
# COACH_ALLOW_DEMO=1
